# Opsiyonel: https://app.reqres.in/api-keys — canlı API için
# REQRES_API_KEY=your_api_key_here

# Opsiyonel: Reqres base URL override
REQRES_BASE_URL=https://reqres.in

# Her zaman yerel mock (canlı API'ye gitme)
# REQRES_USE_MOCK=true

# API key varken DNS hatasında mock'a düşme; canlı API zorunlu (CI)
# REQRES_STRICT_LIVE=true
